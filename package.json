{
  "name": "ai-scene-composer",
  "private": true,
  "version": "0.0.0",
  "description": "A lightweight 3D virtual set and camera blocking tool for AI image generation.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "pnpm --filter @asc/resource-library gen",
    "dev": "pnpm gen && turbo run dev",
    "build": "pnpm gen && turbo run build",
    "build:web": "pnpm gen && pnpm --filter @asc/client build:web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test apps/client/src/store/editorStore.test.ts packages/resource-library/src/catalog.test.ts services/api/src/routes/generate.test.ts services/api/src/middleware/auth.test.ts",
    "check": "pnpm gen && pnpm format:check && pnpm lint && pnpm exec turbo run typecheck --force && pnpm test && pnpm --filter @asc/resource-library check && pnpm build",
    "ci": "pnpm check",
    "web": "pnpm gen && pnpm --filter @asc/client web",
    "api": "pnpm --filter @asc/api dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
