rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 用户私有产物(截图、成图)按 uid 隔离
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 公共只读预设资产(glTF、缩略图);写入仅限后台/管理
    match /models/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
