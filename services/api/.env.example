# services/api 环境变量(复制为 .env;.env 已在 .gitignore)

PORT=8080

# 本地开发跳过 Firebase 鉴权(仅本地!)。
# 生产无效:当 NODE_ENV=production 时,即便 SKIP_AUTH=1 也会被忽略并强制校验。
SKIP_AUTH=1
# NODE_ENV=production   # 生产部署时设置(此时 SKIP_AUTH 被忽略)

# CORS:逗号分隔的允许来源;不设则开发态回显请求来源(宽松)。
# 生产示例:ALLOWED_ORIGIN=https://your-app.web.app,https://your-app.firebaseapp.com
ALLOWED_ORIGIN=

# 限流(仅 /api/generate):时间窗(毫秒)与窗口内请求上限
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# Gemini / Nano Banana 2
# BYOK:客户端可在「设置」里自带 Key,随请求经 x-gemini-key 头发来,则此项可留空。
# 两者都缺时 /api/generate 会报「未提供 API Key」。
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Firebase Admin:Cloud Run 自动注入凭据;本地需服务账号文件
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
